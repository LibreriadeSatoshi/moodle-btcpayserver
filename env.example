# Moodle Docker development environment configuration
# Copy this file to env and customize: cp env.example env

# Moodle branch to clone (e.g., MOODLE_405_STABLE, MOODLE_411_STABLE, main)
MOODLE_BRANCH=MOODLE_405_STABLE

# Plugin path within Moodle (payment gateway is at payment/gateway/btcpay)
PLUGIN_PATH=payment/gateway/btcpay

# Database server to use (pgsql, mariadb, mysql, mssql, oracle)
MOODLE_DOCKER_DB=pgsql

# Optional: public URL for Moodle (e.g. ngrok). If set, $CFG->wwwroot uses this so
# redirects and webhooks use the public URL instead of localhost.
# MOODLE_DOCKER_WEB_HOST=your-subdomain.ngrok-free.app
# MOODLE_DOCKER_WEB_PORT=443
# MOODLE_DOCKER_WEB_SCHEME=https
